{
    "name": "cloudtron-oneclick",
    "version": "1.4.0",
    "description": "Cloudtron Desktop AI Engine com NVIDIA NIM",
    "main": "main.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/felipeptxa/cloudtron.git"
    },
    "githubRepo": "felipeptxa/cloudtron",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win",
        "test": "node test/suite.js",
        "test:unit": "node test/suite.js",
        "test:e2e": "playwright test",
        "review": "node scripts/pipeline-verify.js --stage review",
        "pipeline": "node scripts/pipeline-verify.js --all"
    },
    "build": {
        "appId": "com.felipemonroe.cloudtron",
        "productName": "Cloudtron OneClick",
        "artifactName": "Cloudtron-OneClick-Setup-${version}.${ext}",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": true,
            "differentialPackage": false,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Cloudtron OneClick"
        }
    },
    "keywords": [
        "nvidia",
        "nemotron",
        "desktop",
        "ai",
        "playwright",
        "pipeline"
    ],
    "author": "Felipe Monroe",
    "license": "MIT",
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "electron": "^45.2.3",
        "electron-builder": "^26.0.2"
    },
    "dependencies": {
        "adm-zip": "^0.6.1",
        "mammoth": "^1.13.0",
        "officeparser": "^8.5.0",
        "pdf-parse": "^2.4.5",
        "xlsx": "^0.18.5"
    }
}
